# Configuração do ambiente de desenvolvimento (docker compose).
# Copie para .env e preencha. O .env nunca vai para o git.
# A lista completa, com o serviço de cada variável, está em docs/arquitetura.md.

# --- Banco (serviço db, só no desenvolvimento) ---
POSTGRES_USER=augusto
POSTGRES_PASSWORD=augusto
POSTGRES_DB=augusto
# Dentro do compose o host é "db". Fora dele (ex.: ferramenta de banco), use localhost.
DATABASE_URL=postgresql://augusto:augusto@db:5432/augusto

# --- API ---
# Opcional: título da documentação OpenAPI.
APP_NAME=Augusto Barbearia API
# E-mails da administração, separados por vírgula (RN-71).
ADMIN_EMAILS=
# JWT do web para a API: o web emite com ISSUER e AUDIENCE, e a API confere.
AUTH_JWKS_URL=http://web:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=http://localhost:3000
# E-mail via Resend (docs/specs/notificacoes-email.md). Sem chave, os e-mails
# só aparecem no log da API. Com chave, EMAIL_FROM é obrigatório
# (ex.: Augusto Barbearia <onboarding@resend.dev> no domínio de testes).
RESEND_API_KEY=
EMAIL_FROM=
# Base dos links nos e-mails.
WEB_BASE_URL=http://localhost:3000

# --- Web ---
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Credenciais OAuth do Google (projeto criado na #23). Nunca cole o secret em chat ou issue.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Endereço da API na rede interna do compose.
API_INTERNAL_URL=http://api:8000

# --- Modo demonstração (docs/specs/modo-demonstracao.md, ADR 0011) ---
# true: /entrar oferece duas contas fictícias sem Google, e as páginas mostram a
# faixa "Ambiente de demonstração". Para a de administração abrir /admin,
# acrescente admin@demo.augustobarbearia.local ao ADMIN_EMAILS acima.
# Nunca ligue na produção: numa imagem de produção a flag ainda exige
# DEMO_LOGIN_ACKNOWLEDGE=public-demo, que só o docker-compose.demo.yml define.
DEMO_LOGIN_ENABLED=false
