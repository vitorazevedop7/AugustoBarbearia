# Opcional: título exibido na documentação OpenAPI.
APP_NAME=Augusto Barbearia API

# Obrigatória. Fora do compose, o host é localhost.
DATABASE_URL=postgresql://augusto:augusto@localhost:5432/augusto

# JWT emitido pelo Better Auth. No compose, AUTH_JWKS_URL usa o host web.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
# Devem ser iguais aos valores usados pelo web na emissão do token.
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=http://localhost:3000
# E-mails autorizados, separados por vírgula (RN-71); vazio não concede admin.
ADMIN_EMAILS=

# E-mail via Resend. Sem chave, os e-mails só aparecem no log da API.
# Com chave, EMAIL_FROM é obrigatório (ex.: Augusto Barbearia <agenda@dominio>).
RESEND_API_KEY=
EMAIL_FROM=
# Base do link "Meus agendamentos" nos e-mails.
WEB_BASE_URL=http://localhost:3000
