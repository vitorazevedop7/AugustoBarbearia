# Configuração da demonstração no notebook (docker-compose.demo.yml, ADR 0010).
# O scripts/demo.sh cria o .env.demo a partir deste arquivo, copia do .env as
# credenciais do Google, os e-mails da administração e o Resend, e gera o
# segredo. O .env.demo nunca vai para o git.

# Link público do túnel. O script preenche a cada subida; não edite à mão.
DEMO_URL=

# E-mails da administração, separados por vírgula (RN-71).
ADMIN_EMAILS=

# Gerado pelo script com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Cliente OAuth "— local" do Google. No dia, cadastre nele o DEMO_URL
# (origem) e DEMO_URL/api/auth/callback/google (redirecionamento).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional. Sem chave, os e-mails só aparecem no log da API. Com o remetente
# de testes do Resend, eles chegam só ao dono da conta.
RESEND_API_KEY=
EMAIL_FROM=

# Modo demonstração (#199, docs/specs/modo-demonstracao.md): /entrar oferece
# "Entrar como administração (demo)" e "Entrar como cliente (demo)", sem Google.
# Ligado por padrão na demonstração; false desliga. A conta fictícia de
# administração já entra no ADMIN_EMAILS pelo docker-compose.demo.yml.
DEMO_LOGIN_ENABLED=true
